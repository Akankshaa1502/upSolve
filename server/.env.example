# Copy to .env and fill in. Never commit .env.

# development | production | test
NODE_ENV=development
PORT=4000

# MongoDB connection string (local or Atlas), e.g.
#   mongodb://127.0.0.1:27017/upsolve
#   mongodb+srv://<user>:<password>@<cluster>/upsolve
# Use "memory" to run an in-memory MongoDB with no install (dev/demo only, data resets on restart).
MONGO_URI=memory

# Long random string, at least 32 chars in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# true = (re)create the demo user on boot. Handy with MONGO_URI=memory.
SEED_ON_START=true
